{
  "name": "ras-parser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "backend/parser.js",
  "scripts": {
    "start": "bash ops/run-parser-supervised.sh",
    "db:migrate": "docker exec -i ras_pg psql -U ras -d ras < backend/db/schema.sql",
    "db:migrate-logs": "docker exec -i ras_pg_logs psql -U ras_logs -d ras_logs < backend/db/logs_schema.sql",
    "db:migrate-reports": "docker exec -i ras_pg psql -U ras -d ras < backend/db/search_reports_schema.sql",
    "download:acts": "RAS_PDF_PARALLEL_DOWNLOADERS=auto RAS_PDF_POOL_COUNTRY_IDS=all RAS_PDF_TARGET_COUNTRY_IDS=82,100,22,15,61,72,122,147,148,152,180 RAS_PDF_BAD_COUNTRY_IDS=1,2 RAS_PDF_PREFLIGHT_GEO=1 RAS_PDF_MAX_WORKERS=0 RAS_PDF_LEASE_CLEANUP_ON_START=1 HTTP_CONCURRENCY=1 HTTP_RETRIES=1 HTTP_TIMEOUT_MS=20000 RAS_PDF_QUARANTINE_INFRA_THRESHOLD=3 RAS_PDF_QUARANTINE_451_THRESHOLD=3 RAS_PDF_QUARANTINE_WINDOW_MS=180000 RAS_PDF_QUARANTINE_MS=300000 RAS_PDF_QUARANTINE_451_MS=600000 RAS_PDF_SUPERVISOR_MAX_RESTARTS=200 RAS_PDF_STUCK_TIMEOUT_MS=1800000 RAS_PDF_STUCK_FATAL_MS=5400000 RAS_PDF_PRAVOCAPTCHA_GATE_STREAK=1 xvfb-run -a --server-args='-screen 0 1366x900x24' node --env-file=.env backend/tools/download-acts.js",
    "download:acts:headless": "node --env-file=.env backend/tools/download-acts.js",
    "probe:geo": "xvfb-run -a --server-args='-screen 0 1366x900x24' node --env-file=.env backend/proxy-tools/probe-geo.js",
    "probe:ras-countries": "node --env-file=.env backend/proxy-tools/probe-ras-countries.js",
    "preflight:proxy-health": "node --env-file=.env backend/proxy-tools/preflight-proxy-health.js",
    "proxy:operator": "node --env-file=.env backend/proxy-tools/mp-proxy-api.js operator",
    "proxy:geo": "node --env-file=.env backend/proxy-tools/mp-proxy-api.js geo",
    "proxy:ip": "node --env-file=.env backend/proxy-tools/mp-proxy-api.js ip",
    "proxy:list": "node --env-file=.env backend/proxy-tools/mp-proxy-api.js list",
    "proxy:leases:status": "node --env-file=.env backend/proxy-tools/proxy-leases.js status",
    "proxy:leases:cleanup": "node --env-file=.env backend/proxy-tools/proxy-leases.js cleanup",
    "embed:worker": "node --env-file=.env backend/indexing/embed-worker.js",
    "embed:fullact": "node --env-file=.env backend/indexing/index-acts-qdrant-fullact.js",
    "embed:chunk": "node --env-file=.env backend/indexing/index-acts-qdrant.js",
    "qdrant:rebuild": "node --env-file=.env backend/indexing/qdrant-rebuild-collection.js",
    "backfill:tokens": "node --env-file=.env backend/indexing/backfill-token-count.mjs",
    "embed:search": "node --env-file=.env backend/search/search-qdrant-rrf.js",
    "embed:rerank": "node --env-file=.env backend/search/search-qdrant-rerank.js",
    "search:api": "node --env-file=.env backend/search/search-api.js",
    "cleanup:invalid": "node --env-file=.env backend/tools/cleanup-invalid-acts.js",
    "telegram:bot": "node --env-file=.env frontend/telegram/bot.js",
    "telegram:bot:supervised": "bash ops/run-tg-bot-supervised.sh",
    "test:probe-classifier": "node backend/proxy-tools/probe-classifier.test.mjs",
    "test:meta-antifraud-smoke": "node backend/network/metadataResponseDetect.test.mjs",
    "test:config-target-override": "node backend/network/config.target-override.test.mjs",
    "smoke:lease": "node --env-file=.env backend/pdf/lease.smoke.mjs",
    "smoke:proxy-health": "node backend/pdf/proxyHealth.smoke.mjs",
    "test:pdf-smoke": "node backend/pdf/repeat451.smoke.mjs",
    "test:quarantine-smoke": "node backend/pdf/quarantine.smoke.mjs",
    "test:cleanup-smoke": "node --env-file=.env backend/db/cleanupInvalidActs.smoke.mjs",
    "test:rerank-budget": "node backend/embed/rerank.budget.smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mobileproxy/sdk": "^1.0.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "ghost-cursor-playwright": "^2.1.0",
    "marked": "^18.0.4",
    "pg": "^8.20.0",
    "playwright": "^1.49.0",
    "socks-proxy-agent": "^10.0.0",
    "undici": "^6.25.0"
  }
}
