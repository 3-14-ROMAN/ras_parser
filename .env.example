# API token для MobileProxy.Space (https://mobileproxy.space/api.html).
# Найти в личном кабинете провайдера. Без него эскалация до changeEquipment
# работать не будет — останется только changeIp через rotation endpoint.
MP_API_TOKEN=

# proxy_key из дашборда. Используется и для changeIp (rotation endpoint),
# и для резолва proxy_id через getMyProxy.
MP_PROXY_KEY=

# Опционально: если знаем proxy_id заранее, можно не дёргать getMyProxy
# на старте. Если пусто — резолвим автоматически по proxy_key.
# MP_PROXY_ID=

# Адрес/логин/пароль HTTP-прокси (то, что ставится в Chromium).
MP_PROXY_SERVER=http://mproxy.site:12695
MP_PROXY_USER=
MP_PROXY_PASS=

# Hard-cooldown между changeIp вызовами (сек). Должен быть ≥
# того, что считает разумным провайдер.
MP_CHANGE_IP_COOLDOWN_SEC=15

# Лимиты лестницы эскалации (см. README → «Политика смены региона»).
#
# changeIp подряд до changeEquipment(operator). Дефолт 8 — пользователь
# просил «менять регион только когда смена IP не помогла», поэтому
# даём L1 ротации IP много шансов прежде чем эскалироваться.
ESC_MAX_IP_BEFORE_EQUIPMENT=8
# changeEquipment(operator) подряд до changeEquipment(geo). changeOperator
# теперь СТРОГО в текущем geoid (никаких слепых фоллбеков на любое eid).
ESC_MAX_OPERATOR_BEFORE_GEO=2
# changeEquipment(geo) на весь прогон. ВНИМАНИЕ: смена региона ПЛАТНАЯ.
# Эскалатор и так зовёт её ТОЛЬКО при kind='net_down' (полный отвал сети)
# и только после L1, но этот лимит — верхняя страховка.
ESC_MAX_GEO_SWAPS=5
# суммарный потолок вызовов recoverFrom (страховка от бесконечности):
ESC_MAX_TOTAL_FAILURES=40
# и общий тайм-бюджет работы эскалатора в секундах:
ESC_MAX_BUDGET_SEC=3600

# --- Geo-фильтры ProxyEscalator.changeGeo ---
# 1 = брать только Россию (id_country=1) при смене гео. По дефолту 1.
GEO_RU_ONLY=1
# Города, в которые НЕ въезжать при смене гео (id_city через запятую).
# Дефолт: 1 (Москва), 173 (СПб). Пусто = дефолт.
# GEO_BLOCK_CITY_IDS=1,173
# Regexp по geo_caption (case-insensitive). По дефолту режутся
# Москва/СПб + все миллионники + Краснодар. Если хочешь разрешить
# конкретный город — переопредели регулярку (или сделай менее жёсткой).
# GEO_BLOCK_CAPTION_REGEX=\b(Москва|Санкт[-\s]?Петербург|Новосибирск|...)\b
