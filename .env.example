# API token для MobileProxy.Space (https://mobileproxy.space/api.html).
# Найти в личном кабинете провайдера. Обязателен: без него парсер
# завершится ошибкой (legacy-режим без SDK удалён).
MP_API_TOKEN=

# proxy_key из дашборда. Используется и для changeIp (rotation endpoint),
# и для резолва proxy_id через getMyProxy.
MP_PROXY_KEY=

# Опционально: если знаем proxy_id заранее, можно не дёргать getMyProxy
# на старте. Если пусто — резолвим автоматически по proxy_key.
# MP_PROXY_ID=

# Адрес/логин/пароль HTTP-прокси (то, что ставится в Chromium).
# Используется parser.js (сбор метаданных, 1 IP) и как single-proxy fallback
# для downloader'а, если auto-discover через getMyProxy не сработал.
# В multi-IP режиме (download:acts) этот блок игнорируется — все прокси
# подтягиваются автоматически по MP_API_TOKEN.
MP_PROXY_SERVER=http://mproxy.site:12695
MP_PROXY_USER=
MP_PROXY_PASS=

# --- Multi-IP пул для PDF downloader'а (download:acts) ---
# По умолчанию downloader сам дёргает getMyProxy() и поднимает по одному
# Chromium на каждый активный прокси аккаунта (4 IP = 4 параллельных
# воркера ≈ ×4 скорость скачивания, без ddos-guard 429 — троттл per-IP).
#
# Если хочешь ограничить параллелизм (например, проверить single-IP
# поведение, или у тебя слабый сервер) — поставь число:
#   RAS_PDF_PARALLEL_DOWNLOADERS=1
# Пусто / auto / 0 = использовать ВСЕ найденные прокси.
# RAS_PDF_PARALLEL_DOWNLOADERS=auto
#
# Whitelist proxy_key'ев, которые брать из getMyProxy. Пусто = брать все.
# Формат: CSV или через пробел.
# MP_PROXY_KEYS=key_abc123,key_def456

# --- Авто-покупка прокси (тратит деньги аккаунта!) ---
# Если =1, перед стартом download:acts проверяет баланс и докупает
# самые дешёвые прокси на свободные деньги. Никогда не превышает
# RAS_AUTO_BUY_MAX_COUNT (включая уже купленные). Сама фича OFF по умолчанию,
# деньги не списываются без явного opt-in.
RAS_AUTO_BUY_PROXIES=0
# Cap общего числа прокси на аккаунте (купленные + новые). Не покупаем больше.
RAS_AUTO_BUY_MAX_COUNT=10
# Период аренды в днях (тарифы у MP: 1/7/30/90/365). 1 = самый дешёвый
# короткий — удобен для разовых обходов и аналитики.
RAS_AUTO_BUY_PERIOD_DAYS=1
# id_country. Если пусто — клонируем страну существующего прокси
# (используется для multi-IP режима «такие же мобильники как уже есть»),
# или Кыргызстан (100) как safe default.
# RAS_AUTO_BUY_COUNTRY_ID=100

# Cooldowns — единственное реальное ограничение MobileProxy.Space.
# Сами действия (changeIp/changeEquipment/changeGeo) бесплатные.
# changeIp — не чаще чем раз в 120 сек.
MP_CHANGE_IP_COOLDOWN_SEC=120
# changeEquipment / changeGeo — не чаще чем раз в 180 сек.
ESC_EQUIPMENT_COOLDOWN_SEC=180
MP_CHANGE_GEO_COOLDOWN_SEC=180

# Лестница эскалации крутится бесконечно: L1 (changeIp) → L2 (changeOperator)
# → L3 (changeGeo) → снова L1. EscalationExhausted в штатном флоу не кидается,
# парсер рассчитан на месячные прогоны без остановки.
#
# changeIp подряд до перехода на L2.
ESC_MAX_IP_BEFORE_EQUIPMENT=3
# changeOperator подряд до перехода на L3.
ESC_MAX_OPERATOR_BEFORE_GEO=2

# --- Адаптивное дробление окна по latency (Query Downgrade + Circuit Breaker) ---
# Если один POST /Search отвечает дольше RAS_SLOW_RESPONSE_THRESHOLD_MS, парсер
# прерывает оставшуюся пагинацию текущего окна, дробит его на
# RAS_WINDOW_SPLIT_FACTOR подокон, ротейтит IP (kind=banned, без changeGeo)
# и повторяет запрос уже на более лёгкой выборке — до того, как RAS успеет
# накинуть 451. Уже сохранённые items не теряются (инкрементальный _save()
# + dedup по TypeId в documentTypes).
#
# 0 = фича отключена, latency игнорируется (поведение как до фичи).
# Дефолт 5000 — нижняя граница диапазона «5–7 секунд», где RAS обычно начинает
# давить на наш IP. Поднимать имеет смысл только если ваш мобильный канал
# в принципе отдаёт /Search дольше нескольких секунд в норме.
RAS_SLOW_RESPONSE_THRESHOLD_MS=5000
# На сколько кусков дробить окно при срабатывании. Минимум 2.
RAS_WINDOW_SPLIT_FACTOR=2
# Нижняя граница дробления (в днях). На под-окне такой длины split не
# делается — только _recoverFrom('banned') и retry на том же диапазоне.
RAS_WINDOW_MIN_DAYS=1

# Потолок страниц выдачи (POST /Search) на одно календарное подокно.
# RAS_MAX_SEARCH_PAGES=40
# Подряд пустых «внешних» календарных окон (нет дел) — автостоп.
# ≤0 или не задавать = без лимита (рядом с простым календарём можно долго идти по пустым дням).
# Чтобы вернуть старое ограничение «что-то не так после N пустых»: RAS_EMPTY_WINDOW_STREAK_LIMIT=60
# RAS_EMPTY_WINDOW_STREAK_LIMIT=0
# Сколько мс ждать первый POST /Search после «Найти» в режиме heartbeat (минимум 5000).
# RAS_WAIT_SEARCH_MS=60000

# Если провайдер вернул тот же new_ip подряд после changeIp — парсер пересоздаёт
# браузер и снова прогоняет текущее календарное окно с начала. Потолок таких
# перезапусков на одно окно (страховка от бесконечного цикла).
# RAS_MAX_DUP_IP_RECYCLES=8

# После успешного changeIp при HTTP-бане (451/403/…) пересоздавать Chromium и
# снова жать «Найти» — main заново прогонит то же календарное окно с 1-й страницы.
# Отключить, если нужны только смена IP без полного recycle: =0
# RAS_RECYCLE_BROWSER_AFTER_BANNED_L1=1

# --- Диапазон дат и циклы (parser.js, см. README) ---
# Режим работы:
# - types          -> сбор справочника document_types.json
# - decision_links -> обход карточек и сбор ссылок PDF в decision_links.json
RAS_MODE=types
# Фильтр формы поиска RAS: п. 3.1 «споры по договорам поставки» (клик по дереву
# категорий перед «Найти»). 1/on/yes = вкл, 0/off/no = выкл. Пусто = спросит в терминале.
# RAS_SUPPLY_FILTER_31=1
# Верхний фильтр результатов после первого поиска: «Статус -> Только завершенные».
# 1/on/yes = вкл, 0/off/no = выкл. Пусто = спросит в терминале при старте.
# RAS_STATUS_FINISHED_ONLY=1
# Фильтр «Тип документа» (РАК): выбрать три пункта
# «Решение», «Постановление апелляции», «Постановление кассации».
# 1/on/yes = вкл, 0/off/no = выкл. Пусто = спросит в терминале при старте.
# RAS_DOC_FILTER_RAK=1
# 1 = шумные логи антифрода в консоль ([stealth/wait], каждый клик/набор).
# RAS_TRACE_STEALTH=1
#
# --- Watchdog «тишины» в parser.js + supervisor (автономность) ---
# Каждое сообщение log() в parser.js трактуется как heartbeat прогресса.
# Если за N миллисекунд (RAS_WATCHDOG_STUCK_MS) ни одного лога — считаем
# процесс зависшим (Playwright потерял контекст, jQuery-callback в задумчивости,
# зомби-await), пишем diagnostic dump в stderr и выходим с кодом 73.
# Supervisor (npm start = scripts/run-parser-supervised.sh) автоматически рестартит парсер.
# По умолчанию 2 мин. После 50% порога watchdog пишет heartbeat в stderr
# (`[watchdog] alive, silent=Xs/Ys`) — видно, что он жив и сколько до exit.
# Подними если у тебя длинные «правомерные» паузы (медленный proxy и т.п.).
# RAS_WATCHDOG_STUCK_MS=300000
# Период проверки watchdog'а (по умолчанию 30s).
# RAS_WATCHDOG_INTERVAL_MS=30000
# Hard deadline на одну попытку _setupSearchSession (goto → 3.1 → «Найти» → РАК → Статус).
# Без него _stealth.click() без явного таймаута мог зависнуть навечно (см. лог
# залипания после «Перехвачен POST /Search» на 140с). По умолчанию 150с — внутри
# setup идёт 5 POST /Search × ~5–10с с буфером на UI-кликов. Если хочешь жёстче —
# поставь 90000–120000. Не делай меньше watchdog/2.
# RAS_SETUP_ATTEMPT_DEADLINE_MS=150000
# Supervisor (scripts/run-parser-supervised.sh, запускается через `npm start`).
# Базовая задержка между рестартами. При коротких сессиях (см. SHORT_RUN_SEC)
# удваивается до RESTART_DELAY_MAX_SEC; при здоровых (см. HEALTHY_RUN_SEC)
# сбрасывается обратно. Это спасает от рестарт-шторма когда проблема системная.
# RAS_PARSER_RESTART_DELAY_SEC=5
# RAS_PARSER_RESTART_DELAY_MAX_SEC=300
# RAS_PARSER_SHORT_RUN_SEC=60       # uptime < этого → backoff удваивается
# RAS_PARSER_HEALTHY_RUN_SEC=600    # uptime ≥ этого → backoff сбрасывается
# Flap-detect: если ≥ FLAP_MAX_IN_WINDOW крахов случилось за FLAP_WINDOW_SEC,
# supervisor выходит с кодом 99. Дефолты (10 крахов / 5 мин) — это «парсер
# не успевает стартовать, нужен человек». Молотить в стену бессмысленно.
# RAS_PARSER_FLAP_WINDOW_SEC=300
# RAS_PARSER_FLAP_MAX_IN_WINDOW=10
# Кэп общего числа рестартов (0 = безлимит). Для месяцев работы оставляй 0;
# защита от долбежа закрыта flap-detect выше.
# RAS_PARSER_MAX_RESTARTS=0
# Опт-аут интерактивных промптов parser.js даже когда stdin = TTY.
# Supervisor сам ставит RAS_NONINTERACTIVE=1 для attempt>=2, чтобы рестарт
# не зависал на «Показывать экран браузера?»/«Дата до?»/«Категория?» и
# сразу подсасывал параметры из env + parser_state.json. Можешь поставить
# здесь руками, если хочешь чтобы и первый запуск был без вопросов
# (полная автономия через cron/systemd/headless box):
# RAS_NONINTERACTIVE=1
# Timeout для page.goto в parser.js. Раньше был хардкод 120с — на медленной/мёртвой
# прокси приходилось долго ждать TimeoutError, чтобы эскалатор начал крутить IP.
# Теперь 45с по умолчанию: голый GET через мобильный прокси открывает RAS за 5-15с,
# 45с с запасом. Подними если у тебя плохой канал.
# RAS_GOTO_TIMEOUT_MS=45000
# Preflight через undici перед каждым Chromium-goto: лёгкий HTTP-probe ras.arbitr.ru
# через текущий прокси. Если 451 / timeout / нет RAS-маркеров в body — пропускаем
# дорогой Playwright-goto и сразу идём в _recoverFrom (эскалатор крутит IP).
# Экономит до 40с на каждой попытке с мёртвым IP. По умолчанию ВКЛ.
# RAS_PARSER_PREFLIGHT=1
# RAS_PARSER_PREFLIGHT_TIMEOUT_MS=8000
# Timeout для прямых POST /Search (страницы 2..N). Раньше был хардкод 60с × 8 попыток
# = до 8 минут на одну страницу с гнилым прокси. 30с — здоровый канал укладывается
# в 1-3с, 30с уже сигнал что прокси протух → recovery + recycle браузера.
# RAS_SEARCH_POST_TIMEOUT_MS=30000
# Максимум попыток на одну страницу /Search. Раньше 8 — но с recycle после каждой
# rotate'и дрочить старый TCP-туннель не нужно. 4 = две полных лестницы recovery.
# RAS_SEARCH_PAGE_MAX_ATTEMPTS=4
# Recycle Chromium после каждого успешного recovery (changeIp/operator/geo): закрывает
# keep-alive TCP-туннели, чтобы следующий запрос точно пошёл через новый IP.
# По умолчанию ВКЛ. Выключение: RAS_RECYCLE_BROWSER_AFTER_BANNED_L1=0
# RAS_RECYCLE_BROWSER_AFTER_BANNED_L1=1
#
# --- Fingerprint Chromium (pravocaptcha / DDoS-Guard) ---
# UA подставляется из версии bundled Chromium (playwright-core/browsers.json).
# Свой Chrome через RAS_CHROME — задайте совпадающую версию:
# RAS_CHROME_VERSION=131.0.6778.264
# Либо целиком: RAS_USER_AGENT=Mozilla/5.0 ...
# Постоянный профиль (куки между прогонами), не удаляется при recycle по dup-IP:
# RAS_BROWSER_USER_DATA_DIR=/data/ras_chromium_profile
# Отключить init-script и webdriver-патч (только отладка): RAS_DISABLE_BROWSER_ANTIDETECT=1
# Вернуть ручную подмену Client Hints (обычно не нужно): RAS_SEC_CH_UA="..."
# Для decision_links: CSV/пробелы/переносы с TypeId, например:
# RAS_TARGET_TYPE_IDS=12f3...,a8b9...
# Пусто => parser спросит в терминале.
# RAS_TARGET_TYPE_IDS=
# RAS_DATE_TO=03.05.2026
# RAS_DATE_FROM=01.01.2020
# RAS_DATE_FROM=none

# --- Geo-фильтры ProxyEscalator.changeGeo ---
# 1 = брать только Россию (id_country=1) при смене гео.
# Для ротации по СНГ по умолчанию выключено.
GEO_RU_ONLY=0
# 1 = включить whitelist стран по GEO_CIS_CAPTION_REGEX.
GEO_CIS_ONLY=1
# id_country, которые запрещены к выбору (по умолчанию: 1 = РФ, 2 = UA).
# По probe-geo 2026-05 РФ-мегафон и UA-Kyivstar → 451 на pravocaptcha даже на
# чистых IP. Если докупаешь линию в одной из этих стран — переопредели.
GEO_EXCLUDE_COUNTRY_IDS=1,2
# Whitelist стран по подписи geo_caption. Дефолт — СТРОГО KZ/BY/KG (см. probe 2026-05).
# Если хочешь расширить (UZ/GE/AM/AZ/TJ/MD) — добавь сюда И убери страну из
# GEO_EXCLUDE_COUNTRY_IDS, если она там.
# GEO_CIS_CAPTION_REGEX=(?:Беларус|Казахстан|Киргиз|Кыргыз|Kazakhstan|Kyrgyz|Kyrgyzstan|Belarus)
# Города, в которые НЕ въезжать при смене гео (id_city через запятую).
# Дефолт: 1 (Москва), 173 (СПб). Пусто = дефолт.
# GEO_BLOCK_CITY_IDS=1,173
# Regexp по geo_caption (case-insensitive). По дефолту режутся
# Москва/СПб + все миллионники + Краснодар. Если хочешь разрешить
# конкретный город — переопредели регулярку (или сделай менее жёсткой).
# GEO_BLOCK_CAPTION_REGEX=\b(Москва|Санкт[-\s]?Петербург|Новосибирск|...)\b

# --- Postgres ---
# DSN канонического sink'а для таблицы `acts`. В режиме сбора актов
# (RAS_MODE=acts / decision_links) переменная ОБЯЗАТЕЛЬНА — без неё parser.js
# упадёт на старте с понятной ошибкой. Принимаются оба имени, RAS_PG_DSN
# в приоритете; если она пустая — берём DATABASE_URL (стандарт docker-compose).
#
# Перед первым запуском один раз прокатить миграцию:
#   docker exec -i ras_pg psql -U ras -d ras < db/schema.sql
# либо (если psql установлен на хосте):
#   psql "$RAS_PG_DSN" -f db/schema.sql
#
# По умолчанию docker-compose поднимает БД `ras` с user/pass `ras:ras`.
RAS_PG_DSN=postgresql://ras:ras@127.0.0.1:5432/ras
# DATABASE_URL=postgresql://ras:ras@127.0.0.1:5432/ras
# Опционально: максимум коннекшенов в pool'е (по умолчанию 8).
# RAS_PG_POOL_MAX=8

# --- PDF download + extract pipeline (scripts/download-acts.js) ---
# Качаем только финальные мотивированные акты (verdict_keep=TRUE) из таблицы acts.
# Скачивание: N параллельных Chromium'ов (по одному на каждый прокси аккаунта;
# см. RAS_PDF_PARALLEL_DOWNLOADERS / MP_PROXY_KEYS выше). На kad.arbitr.ru
# ddos-guard троттлит per-IP, поэтому N прокси = ×N скорость почти линейно.
# Экстракт: M параллельных pdftotext-воркеров. Resume-safe через БД.
#
# Куда складывать PDF (флаг --workdir перебивает; default /data/ras_pdf).
# RAS_PDF_DIR=/data/ras_pdf
# Запускать chromium headless? По умолчанию 0 — pravocaptcha проверяет canvas-
# fingerprint, на headless иногда срывается на image-captcha. Рекомендация:
# headful (=0) под xvfb-run (как в npm-скрипте download:acts).
# RAS_PDF_HEADLESS=0
# Сколько параллельных pdftotext-воркеров. Зависит от CPU; default 6.
# RAS_PDF_EXTRACT_WORKERS=6
# Буфер очереди download→extract (мягкий backpressure, шт.).
# RAS_PDF_QUEUE_BUFFER=32
# Сколько акт-строк брать из БД за раз (после исчерпания батч-цикл повторится).
# RAS_PDF_BATCH=320
# Остановка после N скачанных PDF. 0 = без лимита.
# RAS_PDF_MAX_RUN=0
# Максимум попыток скачать один акт до перевода в pdf_error.
# RAS_PDF_MAX_ATTEMPTS=5
# Пауза между PDF после успеха (мс): случайно из [min..max]. Короче — быстрее,
# но выше риск 429 с одного IP. После фейла — отдельно RAS_PDF_PAUSE_FAIL_*.
# RAS_PDF_PAUSE_MIN_MS=220
# RAS_PDF_PAUSE_MAX_MS=520
# RAS_PDF_PAUSE_FAIL_MIN_MS=90
# RAS_PDF_PAUSE_FAIL_MAX_MS=200
# Хранить .pdf на диске после extract? 1=да (по умолчанию), 0=удалять.
# Сейчас держим — место не бутылочное горлышко, иногда нужен повторный extract.
# RAS_PDF_KEEP_FILE=1
# Таймаут pdftotext на один PDF (мс).
# RAS_PDF_EXTRACT_TIMEOUT_MS=45000
# Минимальный размер извлечённого текста (байт). Если меньше — это скан без OCR,
# помечаем строку как extract failed, чтобы downstream-OCR-сервис её подобрал.
# RAS_PDF_MIN_TEXT_BYTES=200
# Пауза после /Card и после thaw(pdfUrl) — время на pravocaptcha JS. После /Card
# при последующем thaw можно короче (RAS_PDF_PRAVO_AFTER_CARD_MS).
# RAS_PDF_PRAVO_WAIT_MS=4200
# RAS_PDF_PRAVO_AFTER_CARD_MS=2600
# Таймаут goto ras→kad (мс). Без /Card по делу.
# RAS_PDF_WARMUP_TIMEOUT_MS=25000
# Таймаут одного page.evaluate(saltoFetch) в мс.
# RAS_PDF_FETCH_TIMEOUT_MS=45000
# --- Прямой HTTP GET PDF после Playwright-прогрева (undici + куки контекста) ---
# По умолчанию выключено — основной путь salto в Chromium. Включить: RAS_PDF_HTTP_ENABLED=1
# После 20 HTTP-попыток при ok=0 или hit_rate<0.1 HTTP отключается до конца процесса.
# RAS_PDF_HTTP_ENABLED=1
# Алиас: RAS_PDF_HTTP=1 или PDF_HTTP_ENABLED=1
# Глобальный лимит параллельных Node HTTP GET по процессу (несколько Chromium-воркеров делят слоты).
# RAS_PDF_HTTP_CONCURRENCY=16
# Алиас: PDF_HTTP_CONCURRENCY=16
# Ретраи одного HTTP GET (сеть / 5xx). HTML/salto (text/html) не ретраится — сразу fallback на page.evaluate.
# RAS_PDF_HTTP_MAX_ATTEMPTS=3
# RAS_PDF_HTTP_TIMEOUT_MS=7000
# При 429 без RasProxyClient — пауза перед повтором (мс).
# RAS_PDF_RL_NO_PROXY_SLEEP_MS=25000
# PDF-пул (discover): CSV id_country или all|* = все активные proxy_id без фильтра по стране.
# Дефолт — СТРОГО Казахстан/Беларусь/Киргизия (22,82,145). РФ-мобильные → 451 на pravocaptcha.
# RAS_PDF_POOL_COUNTRY_IDS=22,82,145
# Смена гео (L3 changeGeo): только эти страны. Дефолт 22,82,145 (BY,KZ,KG) — синхронизирован с пулом.
# RAS_PDF_TARGET_COUNTRY_IDS=22,82,145
# OVERRIDE имеет приоритет над RAS_PDF_TARGET_COUNTRY_IDS. Нужно для диагностики:
# `npm run download:acts` жёстко задаёт RAS_PDF_TARGET_COUNTRY_IDS в строке script,
# обычный export его не перебивает — а *_OVERRIDE перебивает. Получается через
# `npm run probe:ras-countries` (см. ниже), который печатает готовую строку:
#   export RAS_PDF_TARGET_COUNTRY_IDS_OVERRIDE=<recommended_country_ids>
# RAS_PDF_TARGET_COUNTRY_IDS_OVERRIDE=

# --- Anti-cloaking probe (scripts/probe-ras-countries.js) ---
# Country-level разведка через MobileProxy API `see_the_url_from_different_IPs`.
# Не выбирает конкретный proxy_id — только проверяет, отдаёт ли страна нормальный
# ras/kad без 451. После probe запускать download с RAS_PDF_TARGET_COUNTRY_IDS_OVERRIDE.
#
# Один URL (default https://ras.arbitr.ru/):
# RAS_MP_ANTICLOAK_URL=https://ras.arbitr.ru/
# Несколько URL через запятую (перебивает URL). Recommended только если все ok.
# RAS_MP_ANTICLOAK_URLS=https://ras.arbitr.ru/,https://kad.arbitr.ru/
# Advisory probe для PDF endpoint (НЕ влияет на recommended — pravocaptcha
# зависит от session/cookies, anti-cloak их не даёт).
# RAS_MP_ANTICLOAK_PDF_URL=
# Список стран для probe. Пусто = взять из get_geo_operator_list (count_free>0).
# RAS_MP_ANTICLOAK_COUNTRIES=82,145,22,2,180
# Общий таймаут на task (мс).
# RAS_MP_ANTICLOAK_TIMEOUT_MS=120000
# Период polling tasks (мс, мин 5000 по rate-limit OpenAPI).
# RAS_MP_ANTICLOAK_POLL_MS=5000
# Порог "достаточный body" (байты). Меньше = tiny-body marker = recommended=false.
# RAS_MP_ANTICLOAK_BODY_MIN_BYTES=5000
# RAS_PDF_TIMING=1 — диагностика в логе [pdf/timing], [pipe/timing]

# --- Preflight escape bad country (включён по дефолту) ---
# На старте, ДО запуска worker loop'а, проверяем id_country каждого воркера.
# Если он в bad-list (RU/UA по probe 2026-05: pravocaptcha сразу банит 451) —
# вызываем fast-geo-loop: markBad + changeGeo(target=KZ/BY/KG) + HTTP probe ras/kad
# + restart Chromium surface. Если probe плохой — markBad новый geo, retry.
# Экономит ~100с warmup на воркер (2 acta × 50с до того, как сработает обычный
# consecutivePravocaptchaGate trigger).
# RAS_PDF_PREFLIGHT_GEO=1
# Bad-country list (CSV id_country). По probe 2026-05: 1=РФ (megafone),
# 2=Украина (kievstar/vodafone) — стабильно 451 на pravocaptcha.
# RAS_PDF_BAD_COUNTRY_IDS=1,2
# Порог `pravocaptcha_gate`-fails подряд (на сессии без единого PDF OK)
# до триггера fast-geo-loop. Дефолт 1 = первый же tokenFrom = bad-geo сигнал.
# RAS_PDF_PRAVOCAPTCHA_GATE_STREAK=1

# --- Карантин per proxy_key (in-memory) ---
# Когда туннель прокси отказывает (ERR_TUNNEL_CONNECTION_FAILED) или RAS режет
# Bad-geo fast recovery (_recoverByGeoLoop): changeGeo с blacklist (geo+operator+IP),
# HTTP probe ras/kad до warmup, до-первого-PDF rotateIp×N в текущем geo до markBad.
# RAS_PDF_BAD_GEO_RECOVERY=1
# RAS_PDF_GEO_CHECK_TIMEOUT_MS=120000   # опрос egress после changeGeo (мс)
# RAS_PDF_SAME_IP_ROTATE_ATTEMPTS=3     # rotateIp бюджет в одном geo до markBad+changeGeo.
#                                         Используется и для same-IP-after-changeGeo,
#                                         и для rotate-first до первого PDF OK.
# RAS_PDF_ROTATE_IP_SLEEP_MS=4000       # пауза между rotateIp в одном geo (мс)
# RAS_PDF_RECOVER_MAX_ROUNDS=50         # подряд раундов changeGeo до 120s паузы.
# RAS_PDF_RECOVER_EXHAUSTED_PAUSE_MS=120000  # пауза после max_rounds; для single-worker
#                                              после паузы recovery продолжает поиск (loopUntilSuccess).
# RAS_PDF_BAD_GEO_COOLDOWN_MS=1800000   # 30 мин — за это время geo/operator/IP не выбираются повторно.
#
# MobileProxy.Space provider-side blacklist (см. OpenAPI: add_to_black_list / get_black_list /
# remove_black_list). НЕ путать с локальным BadGeoBlacklist. Параметр change_equipment
# `add_to_black_list=1` кладёт ТЕКУЩЕЕ оборудование в provider blacklist перед сменой —
# на каждом recover это засоряет блек-лист аккаунта. Default OFF.
# RAS_MP_ADD_TO_BLACKLIST_ON_CHANGE_GEO=0
# При старте downloader можно ОДИН раз почистить provider blacklist (equipment+operators).
# Default OFF — без явного флага не лезем (ядерная операция: провайдер снова подсунет
# только что сожжённое оборудование).
# RAS_MP_CLEAR_PROVIDER_BLACKLIST_ON_START=0
#
# HTTP probe ras/kad через текущий прокси ПОСЛЕ нового IP (rotateIp / changeGeo),
# ДО запуска Chromium warmup. Если 451 / timeout / empty body / tokenFrom / ddos-guard /
# pravocaptcha-маркер — markBad geo/operator/IP и идём дальше, не платим warmup.
# RAS_PDF_PROBE_ENABLED=1
# RAS_PDF_PROBE_TIMEOUT_MS=8000         # таймаут одного GET (мс)
# RAS_PDF_PROBE_MIN_BODY=500            # ниже этой длины body — probe плохой (короткий = редирект на капчу)
# RAS_PDF_PROBE_BLOCK_REGEX=tokenFrom|pravocaptcha|ddos-?guard|Just a moment|Attention Required|cf-browser-verification

# IP/гео (HTTP 451) — rotateIp внутри того же proxy_key обычно даёт тот же
# плохой пул. Карантин ВРЕМЕННО выводит прокси из ротации: воркер идёт спать,
# здоровые воркеры доедают общую очередь (deferred-акты вернутся в пул через
# SharedActQueue).
#
# ВАЖНО: реестр живёт в памяти процесса. После рестарта (kill, deploy, crash)
# все cooldown'ы и счётчики обнуляются — новый процесс начинает считать с нуля.
# Это осознанно: проблемные IP за время простоя обычно «остывают» сами, и
# тащить состояние через рестарт смысла мало. Если процесс крутится сутками
# без рестарта, карантин работает как и задумано.
# Порог infra-фейлов в окне — после превышения уводим в cooldown.
# RAS_PDF_QUARANTINE_INFRA_THRESHOLD=5
# Порог 451-defer'ов в том же окне.
# RAS_PDF_QUARANTINE_451_THRESHOLD=3
# Скользящее окно для обоих счётчиков (мс).
# RAS_PDF_QUARANTINE_WINDOW_MS=180000
# Длительность карантина для infra-причины (мс). По умолчанию 10 мин.
# RAS_PDF_QUARANTINE_MS=600000
# Длительность карантина для 451-причины (мс). По умолчанию 30 мин —
# pravocaptcha/гео-бан остывает дольше, чем туннель MobileProxy.
# RAS_PDF_QUARANTINE_451_MS=1800000

# --- Slow-proxy detection (changeGeo на медленный воркер) ---
# После probation (первого PDF OK) recoverable-сигналы вроде `evaluate timeout
# after 45000ms`, ERR_HTTP2_*, "ras/kad timeout" раньше тихо скипались — медленный
# воркер дальше ловил таймауты по 30-60с на цикл warmup. Теперь они считаются
# в trailing-window: при пороге за окно — воркер делает changeGeo и продолжает
# работу. Cooldown НЕ ставится: новый geo либо сразу заработает быстрее, либо
# снова накопит порог и снова сменит. Здоровые воркеры всё это время разбирают
# общую очередь (deferred-акт возвращается в пул).
# Сколько медленных событий — после чего changeGeo. 0 = выключить детектор.
# RAS_PDF_SLOW_THRESHOLD=2
# Скользящее окно для счётчика (мс). По умолчанию 5 минут.
# RAS_PDF_SLOW_WINDOW_MS=300000

# --- Supervisor + no-progress watchdog (download:acts) ---
# Для запусков «на сутки без контроля». Двухслойная защита от тихих залипаний:
#   1) PG-retry на startup-запросах (pipelineStats, selectPendingPdf) — БД может
#      кратко мигнуть на рестарт docker-compose/postgres, мы переждём.
#   2) No-progress watchdog в pipeline.js: считает мс с последнего успешного PDF.
#      Через STUCK_TIMEOUT_MS пишет WARN, через STUCK_FATAL_MS кидает исключение.
#   3) Supervisor loop в scripts/download-acts.js: ловит throw из runPipeline,
#      ждёт backoff (растёт ×1.5 до MAX_MS), перезапускает пайплайн с чистого
#      Chromium-пула. PG-pool тоже закрывается перед рестартом.
#
# Сколько рестартов разрешено за один процесс (после превышения — exit 1).
# 0 = supervisor отключён, при ошибке сразу exit (старое поведение).
# RAS_PDF_SUPERVISOR_MAX_RESTARTS=200
# Backoff между рестартами: стартует с MIN, растёт ×1.5, кэп MAX.
# RAS_PDF_SUPERVISOR_BACKOFF_MIN_MS=10000
# RAS_PDF_SUPERVISOR_BACKOFF_MAX_MS=600000
# Через сколько мс без успешного PDF логировать WARN. Дефолт 30 мин.
# Все воркеры в карантине = это нормально на короткие промежутки, но если
# дольше 30 мин — что-то системно сломалось.
# RAS_PDF_STUCK_TIMEOUT_MS=1800000
# Через сколько мс без успешного PDF кидать исключение → supervisor рестартанёт.
# Дефолт 90 мин. Должен быть > STUCK_TIMEOUT_MS, иначе сразу fatal.
# RAS_PDF_STUCK_FATAL_MS=5400000
# Ретраи PG-запросов selectPendingPdf при потере соединения, начальный backoff.
# RAS_PDF_FETCH_BATCH_MAX_RETRIES=6
# RAS_PDF_FETCH_BATCH_BACKOFF_MS=2000
# Пауза воркера после неожиданного исключения внутри тела цикла (защита от
# каскада фейлов). После 5 подряд воркер выходит, supervisor поднимает заново.
# RAS_PDF_WORKER_UNEXPECTED_PAUSE_MS=30000

# --- Координация proxy_key (таблица `proxy_leases` в Postgres) ---
# Lease берётся атомарно при createPdfPool, продлевается heartbeat'ом, снимается
# на shutdown. При kill -9 TTL спасает: следующий запуск через RAS_PDF_LEASE_
# CLEANUP_ON_START снимет expired + dead-PID этого хоста.
# RAS_PROXY_LEASE_TTL_SEC=300            # TTL аренды (мин 30)
# RAS_PROXY_LEASE_HEARTBEAT_SEC=60       # период renew (мин 10)
# RAS_PDF_LEASE_CLEANUP_ON_START=1       # 1 = на старте подчистить expired+dead
#
# Supervisor: при POOL_ALL_LEASED делает cleanup и ждёт до min(expires_at).
# Потолок ожидания — чтоб не залипать на час, если TTL уехал далеко в будущее.
# RAS_PDF_POOL_ALL_LEASED_MAX_WAIT_MS=300000     # 5 мин кап
# RAS_PDF_POOL_ALL_LEASED_MIN_RECHECK_MS=5000    # короткая пауза после cleanup
#
# CLI для разбора живых аренд:
#   npm run proxy:leases:status         — JSON-снимок (this-host/dead-pid/expired)
#   npm run proxy:leases:cleanup        — снять expired + dead-local
#   node scripts/proxy-leases.js release-key <proxy_key>  — аварийное освобождение

# --- Preflight pre-download probe ras.arbitr.ru (отдельная команда) ---
# `npm run preflight:proxy-health` дёргает MobileProxy.Space anti-cloaking
# (see_the_url_from_different_IPs) на https://ras.arbitr.ru/, классифицирует
# ответы по good/bad markers + body>=20KB, печатает таблицу и CSV с
# recommended-странами. Затем подставь:
#   RAS_PDF_TARGET_COUNTRY_IDS_OVERRIDE=<csv> npm run download:acts
#
# RAS_PROBE_URL=https://ras.arbitr.ru/      # что пробить
# RAS_PROBE_TIMEOUT_MS=120000               # cap на polling tasks
# RAS_PROBE_POLL_MS=5000                    # период polling
# RAS_PROBE_GOOD_BODY_BYTES=20000           # порог body-large good-marker'а
# RAS_PROBE_MAX_COUNTRIES=12                # сколько стран в одном POST

# --- Qdrant (vector DB) ---
# Поднимается через `docker compose up -d qdrant`, том на /data/qdrant.
# REST (6333) — основной endpoint, gRPC (6334) опционально. Биндим на 127.0.0.1.
QDRANT_URL=http://127.0.0.1:6333
# Опциональный API-ключ Qdrant. Пусто = без auth (ок для localhost-бинда).
# Если включаешь — повтори тут и в docker-compose.
# QDRANT_API_KEY=
# Имя коллекции для актов. Размерность вектора задаётся при первом create_collection
# и завязана на embed-модель (см. EMBED_DIM).
QDRANT_COLLECTION=acts_jina_v4

# --- Self-hosted inference (Jina v4 + reranker v3 на локальной V100 32GB) ---
# Модели грузим из HuggingFace в HF_HOME=/data/hf_cache (см. ниже), запускаем
# в отдельном GPU-контейнере. Облачный Jina API НЕ используем.
HF_HOME=/data/hf_cache
# Имя репо на HuggingFace для весов. Не менять без необходимости.
EMBED_MODEL_ID=jinaai/jina-embeddings-v4
RERANK_MODEL_ID=jinaai/jina-reranker-v3
# Адрес локального inference-сервиса (см. docker-compose, сервис `inference`).
# Один сервис обслуживает и /embed, и /rerank.
INFERENCE_URL=http://127.0.0.1:8000

# --- Reranker text mode (embed/hydrate.js) ---
# Какой текст уходит в /rerank. Дефолт — единственный production-режим:
#   postgres_full_act — реранкер ВСЕГДА видит acts.act_text целиком
#     из Postgres, независимо от того, full_act это или chunk/late-chunk
#     кандидат из retrieval (long_dense/long_sparse). Chunk-метаданные
#     (matched_chunk_ids, total_chunks) сохраняются ТОЛЬКО как debug.
#     Token-budget считается по acts.tokens_jina_v3 — счёт того же
#     самого текста, что и пойдёт в реранкер. End-to-end консистентно.
# RAS_RERANK_TEXT_MODE=postgres_full_act

# --- Reranker token-budget (embed/rerank.js) ---
# Перед POST /rerank считаем сумму токенов всех кандидатов и отсекаем хвост,
# который не влез бы в context window. Идём сверху вниз по RRF rank'у;
# первый кандидат, который не помещается → STOP, всё ниже в `dropped` (без
# rerank_score, в хвосте финального списка).
# Per-doc токены: cached в acts.tokens_jina_v3 → /count_tokens → estimate
# (3.5 char/token).
#
# Два режима по RAS_RERANK_MAX_DOC_LENGTH:
#   > 0  → per_doc_cap. Effective = min(real_tokens, RAS_RERANK_MAX_DOC_LENGTH).
#          Реранкер режет каждый doc до этого предела — наш budget это учитывает.
#          Дефолт 2048 (нативный для jina-reranker-v3, см. inference/app.py).
#   <= 0 → full_docs_no_per_doc_cap. Cap снят, effective = full token count.
#          Пакуем полные тексты, пока суммарно влезают в budget. В POST /rerank
#          передаём safe-large value (=RAS_RERANK_MAX_CONTEXT_TOKENS), чтобы
#          inference не подменил на свой дефолт 2048.
# RAS_RERANK_MAX_DOC_LENGTH=2048
# Потолок СУММЫ токенов в одном POST /rerank (не путать с контекстом модели —
# у Qwen3 он 131072 на блок, модель сама бьёт документы на блоки). Кол-во
# кандидатов в reranker ограничено ЯВНО через searchPipeline.rerankCandidateCount
# (topN×2, флор 10, кап 50), поэтому бюджет держим большим, чтобы он НЕ резал
# 50 полных актов (~600k-1.1M токенов). Реальный кап = число кандидатов и
# латентность, а не сумма токенов. В full-doc режиме (выше) — 2M с запасом.
# RAS_RERANK_MAX_CONTEXT_TOKENS=2000000
# Резерв под query (~512), system/user prompt и JSON envelope. С запасом 4K.
# RAS_RERANK_RESERVE_TOKENS=4096
# Verbose: на каждом отсечённом кандидате печатать act_id, tokens, overflow.
# RAS_RERANK_BUDGET_VERBOSE=0
#
# Char-truncate в hydrate (embed/hydrate.js) — режет текст ДО отправки в /rerank.
# Это второй лимит ПОВЕРХ token-budget'а: budget может разрешить 30K токенов,
# но если max_chars=12000, реранкер всё равно увидит хвост на 12K символов.
#   - Если не задано → 12000 (исторический дефолт, был выставлен под Jina v2).
#   - Если задано 0 / negative → не резать.
#   - АВТО: если RAS_RERANK_MAX_DOC_LENGTH<=0 (no per-doc cap), char-truncate
#     тоже автоматически выключается, чтобы фича снятия cap'а работала
#     end-to-end. Явное RAS_RERANK_MAX_CHARS перебивает авто.
# RAS_RERANK_MAX_CHARS=0
# Размерность вектора (v4 dense = 2048; multi-vector 128/токен — отдельная история).
# Должна совпасть с тем, что отдаёт модель при create_collection в Qdrant.
EMBED_DIM=2048
# Task-prefix для v4 (LoRA-adapter): retrieval.passage = индексация актов,
# retrieval.query = поисковые запросы пользователя. text-matching/code — другие адаптеры.
EMBED_TASK=retrieval.passage

# ── HyDE генератор (llm/hydeGenerator.js, эндпоинт POST /hyde) ─────────────
# Превращает бытовой запрос юзера ("поставщик не поставил товар") в синтети-
# ческий фрагмент мотивировочной части акта в стиле реальных судебных
# решений. Дальше этот текст векторизуется и ищется в Qdrant — паттерн HyDE.
#
# API-ключ из Google AI Studio: https://aistudio.google.com/apikey
# Без ключа POST /hyde возвращает 503 (search-api.js всё равно стартует).
GEMINI_API_KEY=
# Имя модели Gemini. Для HyDE — gemini-3.1-pro-preview (актуальный pro
# на момент написания). Альтернативы: gemini-2.5-pro (стабильная),
# gemini-flash-latest (быстро/дёшево), gemini-3-pro-preview (предыдущий 3.x).
# Полный список: ai.models.list() в SDK.
RAS_HYDE_MODEL=gemini-3.1-pro-preview
# Температура: 0.2–0.4 — стабильный канцелярский стиль; 0.7+ — больше
# креатива но просадка стиля (что нам бьёт по embedding-сходству).
RAS_HYDE_TEMPERATURE=0.3
# Потолок выходных токенов. У 3.x reasoning-моделей часть бюджета съедает
# thinking (нельзя отключить для 3.1 Pro — API вернёт 400), поэтому держим
# с запасом: ~1500-2000 на thinking + ~1500 на сам текст. На flash-моделях
# можно урезать до 1024.
RAS_HYDE_MAX_OUTPUT_TOKENS=4096
# Бюджет thinking-токенов: 0 = DISABLED (только не-3.x модели), -1 = AUTO.
# Для 3.1 Pro обязательно -1.
RAS_HYDE_THINKING_BUDGET=-1
# Полный таймаут одного запроса в Gemini.
RAS_HYDE_TIMEOUT_MS=30000
# Прокси для исходящих запросов в Gemini. Нужен из РФ: Google AI Studio
# (generativelanguage.googleapis.com) блокирует российские IP и возвращает
# 400 "User location is not supported". Поддержанные схемы:
#   http://[user:pass@]host:port    — undici EnvHttpProxyAgent
#   https://...                      — то же
#   socks5h://host:port              — undici Agent с custom connect через
#                                       пакет `socks` (DNS на стороне прокси)
#   socks5://[user:pass@]host:port   — то же, но с локальным DNS
# Прокси применяется ТОЧЕЧНО к домену generativelanguage.googleapis.com —
# Qdrant/inference на localhost через него НЕ ходят.
# RAS_HYDE_PROXY_URL=socks5h://127.0.0.1:10819

# ── Local Search API (scripts/search-api.js) ───────────────────────────────
# Биндимся только на loopback — экспонирование наружу прямо запрещено: API
# отдаёт сниппеты по поисковым запросам, но не служит как защищённый endpoint.
RAS_SEARCH_API_HOST=127.0.0.1
RAS_SEARCH_API_PORT=8091
# Используется Telegram-ботом для resolve'а локального API.
RAS_SEARCH_API_URL=http://127.0.0.1:8091
# /search дёргает HyDE (llm/hydeGenerator.js) перед эмбеддингом: бытовой
# запрос → синтетический акт → поиск в Qdrant. Реранкер видит оригинал.
# 1 = ON (дефолт, если GEMINI_API_KEY задан), 0 = OFF (как раньше).
# На любой сбой HyDE происходит fallback на оригинальный query — поиск
# не упадёт от проблем с Gemini/прокси.
RAS_SEARCH_HYDE_ENABLED=1
# Отдельный Postgres для логов поисковых запросов (один docker-compose
# сервис postgres_logs / контейнер ras_pg_logs, volume на HDD, порт 5433).
# Логируется каждый /search вызов: search_id, raw query, настройки, HyDE-
# текст и токены, тайминги pipeline, top_act_ids, results jsonb. Запись
# fire-and-forget, ошибки только в stderr — поиск не зависит от лога.
# Если DSN пуст — логирование выключено.
RAS_PG_LOGS_DSN=postgresql://ras_logs:ras_logs@127.0.0.1:5433/ras_logs

# ── Whisper STT (inference/transcribe_worker.py, порт 8001) ────────────────
# Отдельный процесс от inference/app.py. При старте: model -> CPU RAM,
# CUDA warmup cycle. На запрос: параллельно audio decode + model.to(cuda),
# dummy forward, generate, model.to(cpu). VRAM свободна между запросами.
# RAS_WHISPER_MODEL_PATH=models/whisper-large-v3-russian
# RAS_WHISPER_PORT=8001

# ── Telegram bot (scripts/telegram-bot.js) ─────────────────────────────────
# Токен бота из @BotFather. ОБЯЗАТЕЛЕН для запуска бота, никогда не коммитим.
TELEGRAM_BOT_TOKEN=
# SOCKS-прокси для долгого polling Telegram API (api.telegram.org заблокирован
# в РФ). socks5h:// — DNS резолвится удалённо. Пусто = ходим напрямую.
TELEGRAM_PROXY_URL=socks5h://127.0.0.1:10808
# CSV numeric user IDs, кому разрешено пользоваться ботом. Пусто = OPEN mode
# (стартует с WARN, любой, кто знает @botname, может запрашивать поиск).
TG_BOT_ALLOWED_USER_IDS=
