# API token для MobileProxy.Space (https://mobileproxy.space/api.html).
# Найти в личном кабинете провайдера. Обязателен: без него парсер
# завершится ошибкой (legacy-режим без SDK удалён).
MP_API_TOKEN=

# proxy_key из дашборда. Используется и для changeIp (rotation endpoint),
# и для резолва proxy_id через getMyProxy.
MP_PROXY_KEY=

# Опционально: если знаем proxy_id заранее, можно не дёргать getMyProxy
# на старте. Если пусто — резолвим автоматически по proxy_key.
# MP_PROXY_ID=

# Адрес/логин/пароль HTTP-прокси (то, что ставится в Chromium).
MP_PROXY_SERVER=http://mproxy.site:12695
MP_PROXY_USER=
MP_PROXY_PASS=

# Cooldowns — единственное реальное ограничение MobileProxy.Space.
# Сами действия (changeIp/changeEquipment/changeGeo) бесплатные.
# changeIp — не чаще чем раз в 120 сек.
MP_CHANGE_IP_COOLDOWN_SEC=120
# changeEquipment / changeGeo — не чаще чем раз в 180 сек.
ESC_EQUIPMENT_COOLDOWN_SEC=180
MP_CHANGE_GEO_COOLDOWN_SEC=180

# Лестница эскалации крутится бесконечно: L1 (changeIp) → L2 (changeOperator)
# → L3 (changeGeo) → снова L1. EscalationExhausted в штатном флоу не кидается,
# парсер рассчитан на месячные прогоны без остановки.
#
# changeIp подряд до перехода на L2.
ESC_MAX_IP_BEFORE_EQUIPMENT=3
# changeOperator подряд до перехода на L3.
ESC_MAX_OPERATOR_BEFORE_GEO=2

# --- Адаптивное дробление окна по latency (Query Downgrade + Circuit Breaker) ---
# Если один POST /Search отвечает дольше RAS_SLOW_RESPONSE_THRESHOLD_MS, парсер
# прерывает оставшуюся пагинацию текущего окна, дробит его на
# RAS_WINDOW_SPLIT_FACTOR подокон, ротейтит IP (kind=banned, без changeGeo)
# и повторяет запрос уже на более лёгкой выборке — до того, как RAS успеет
# накинуть 451. Уже сохранённые items не теряются (инкрементальный _save()
# + dedup по TypeId в documentTypes).
#
# 0 = фича отключена, latency игнорируется (поведение как до фичи).
# Дефолт 5000 — нижняя граница диапазона «5–7 секунд», где RAS обычно начинает
# давить на наш IP. Поднимать имеет смысл только если ваш мобильный канал
# в принципе отдаёт /Search дольше нескольких секунд в норме.
RAS_SLOW_RESPONSE_THRESHOLD_MS=5000
# На сколько кусков дробить окно при срабатывании. Минимум 2.
RAS_WINDOW_SPLIT_FACTOR=2
# Нижняя граница дробления (в днях). На под-окне такой длины split не
# делается — только _recoverFrom('banned') и retry на том же диапазоне.
RAS_WINDOW_MIN_DAYS=1

# Потолок страниц выдачи (POST /Search) на одно календарное подокно.
# RAS_MAX_SEARCH_PAGES=40
# Подряд пустых «внешних» календарных окон (нет дел) — автостоп.
# ≤0 или не задавать = без лимита (рядом с простым календарём можно долго идти по пустым дням).
# Чтобы вернуть старое ограничение «что-то не так после N пустых»: RAS_EMPTY_WINDOW_STREAK_LIMIT=60
# RAS_EMPTY_WINDOW_STREAK_LIMIT=0
# Сколько мс ждать первый POST /Search после «Найти» в режиме heartbeat (минимум 5000).
# RAS_WAIT_SEARCH_MS=60000

# Если провайдер вернул тот же new_ip подряд после changeIp — парсер пересоздаёт
# браузер и снова прогоняет текущее календарное окно с начала. Потолок таких
# перезапусков на одно окно (страховка от бесконечного цикла).
# RAS_MAX_DUP_IP_RECYCLES=8

# После успешного changeIp при HTTP-бане (451/403/…) пересоздавать Chromium и
# снова жать «Найти» — main заново прогонит то же календарное окно с 1-й страницы.
# Отключить, если нужны только смена IP без полного recycle: =0
# RAS_RECYCLE_BROWSER_AFTER_BANNED_L1=1

# --- Диапазон дат и циклы (parser.js, см. README) ---
# Режим работы:
# - types          -> сбор справочника document_types.json
# - decision_links -> обход карточек и сбор ссылок PDF в decision_links.json
RAS_MODE=types
# Фильтр формы поиска RAS: п. 3.1 «споры по договорам поставки» (клик по дереву
# категорий перед «Найти»). 1/on/yes = вкл, 0/off/no = выкл. Пусто = спросит в терминале.
# RAS_SUPPLY_FILTER_31=1
# Верхний фильтр результатов после первого поиска: «Статус -> Только завершенные».
# 1/on/yes = вкл, 0/off/no = выкл. Пусто = спросит в терминале при старте.
# RAS_STATUS_FINISHED_ONLY=1
# Фильтр «Тип документа» (РАК): выбрать три пункта
# «Решение», «Постановление апелляции», «Постановление кассации».
# 1/on/yes = вкл, 0/off/no = выкл. Пусто = спросит в терминале при старте.
# RAS_DOC_FILTER_RAK=1
# 1 = шумные логи антифрода в консоль ([stealth/wait], каждый клик/набор).
# RAS_TRACE_STEALTH=1
# Для decision_links: CSV/пробелы/переносы с TypeId, например:
# RAS_TARGET_TYPE_IDS=12f3...,a8b9...
# Пусто => parser спросит в терминале.
# RAS_TARGET_TYPE_IDS=
# RAS_CYCLES=200
# RAS_CYCLES=0 — без лимита по числу циклов (как Enter/0 в интерактиве)
# RAS_DATE_TO=03.05.2026
# RAS_DATE_FROM=01.01.2020
# RAS_DATE_FROM=none

# --- Geo-фильтры ProxyEscalator.changeGeo ---
# 1 = брать только Россию (id_country=1) при смене гео.
# Для ротации по СНГ по умолчанию выключено.
GEO_RU_ONLY=0
# 1 = включить whitelist по СНГ через GEO_CIS_CAPTION_REGEX.
GEO_CIS_ONLY=1
# id_country, которые запрещены к выбору (по умолчанию: 1 = РФ).
GEO_EXCLUDE_COUNTRY_IDS=1
# Whitelist стран СНГ по подписи geo_caption. Можно расширять/сужать.
# GEO_CIS_CAPTION_REGEX=(?:Беларус|Казахстан|Киргиз|Кыргыз|Узбекистан|Грузи|Армени|Азербайджан|Таджикистан|Молдова)
# Города, в которые НЕ въезжать при смене гео (id_city через запятую).
# Дефолт: 1 (Москва), 173 (СПб). Пусто = дефолт.
# GEO_BLOCK_CITY_IDS=1,173
# Regexp по geo_caption (case-insensitive). По дефолту режутся
# Москва/СПб + все миллионники + Краснодар. Если хочешь разрешить
# конкретный город — переопредели регулярку (или сделай менее жёсткой).
# GEO_BLOCK_CAPTION_REGEX=\b(Москва|Санкт[-\s]?Петербург|Новосибирск|...)\b
